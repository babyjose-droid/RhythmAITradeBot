# Copy to .env for local development. PLACEHOLDERS ONLY — never put real secrets in this file.

# Environment: local | test | staging | production
RHYTHM_ENVIRONMENT=local

# Trading mode: RESEARCH_ONLY (default) | PAPER | LIVE
# LIVE is not implemented and the application refuses to start with it.
RHYTHM_TRADING_MODE=RESEARCH_ONLY
# PAPER trading (simulated orders only) needs BOTH of these:
# RHYTHM_TRADING_MODE=PAPER
# RHYTHM_FEATURES__PAPER_TRADING=true

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
RHYTHM_DATABASE_URL=postgresql+psycopg://rhythm:change-me@localhost:5432/rhythm

# Logging
RHYTHM_LOG_LEVEL=INFO
RHYTHM_LOG_JSON=true

# Readiness: maximum tolerated clock skew vs database clock, seconds
RHYTHM_MAX_CLOCK_SKEW_SECONDS=2

# Data sources (Phase 2): none | mock. "mock" = synthetic MOCK data, local/test only.
RHYTHM_MARKET_DATA_PROVIDER=none
RHYTHM_BROKER_ADAPTER=none
# Corporate-event calendar for the swing event gate (R18): none | mock (local/test only)
RHYTHM_EVENT_PROVIDER=none
# Company fundamentals for the long-term horizon (R21): none | mock (local/test only).
# Real data needs a licensed vendor (decision D-03).
RHYTHM_FUNDAMENTALS_PROVIDER=none
# Claude research service (Phase 7, advisory only): none | mock (local/test) | anthropic.
# anthropic needs a model id and an API key. Put the key in your shell or a secret store,
# never in a committed file.
# RHYTHM_FEATURES__RESEARCH_SERVICE=true
RHYTHM_RESEARCH_PROVIDER=none
# RHYTHM_RESEARCH__MODEL=
# RHYTHM_RESEARCH__API_KEY=
# RHYTHM_RESEARCH__DAILY_TOKEN_BUDGET=200000
# When true, PAPER entries/adds need a valid CONFIRM (fail closed). Default false.
# RHYTHM_RESEARCH__GATE_PAPER_ENTRIES=false

# Sign-in (Phase 8): password + authenticator app. On by default.
# Secret key (>= 32 random characters) encrypts authenticator secrets at rest. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it in .env (git-ignored) or a secret store; changing it invalidates enrolled authenticators.
RHYTHM_AUTH__ENABLED=true
RHYTHM_AUTH__SECRET_KEY=
# Optional outgoing webhook for notifications (e.g. a Slack incoming webhook URL; https only).
# RHYTHM_NOTIFICATIONS__WEBHOOK_URL=
# RHYTHM_NOTIFICATIONS__WEBHOOK_MIN_SEVERITY=warning

# Reliability (Phase 9). The compose stack runs a scheduler; readiness needs its heartbeat.
# RHYTHM_SCHEDULER__EXPECTED=true
# Bearer token for GET /metrics (Prometheus). Without it /metrics works only in local/test.
# RHYTHM_METRICS__TOKEN=
# Backups into ./backups (git-ignored): daily, kept 14 days.
# BACKUP_RETENTION_DAYS=14
# BACKUP_INTERVAL_HOURS=24
# Intraday quote freshness threshold, seconds (illustrative paper-test default)
RHYTHM_FRESHNESS_INTRADAY_MAX_AGE_SECONDS=10

# --- Read-only Sharekhan link (README "Connect Sharekhan"). Never commit real values. ---
# Needs sign-in on (RHYTHM_AUTH__ENABLED=true + RHYTHM_AUTH__SECRET_KEY); do not use demo.env.
# Nothing here can place, modify or cancel orders.
# RHYTHM_BROKER_ADAPTER=sharekhan
# RHYTHM_SHAREKHAN__API_KEY=
# The 32-character "Secure Key":
# RHYTHM_SHAREKHAN__SECRET_KEY=
# Only if Sharekhan gave you a vendor key:
# RHYTHM_SHAREKHAN__VENDOR_KEY=

# docker-compose only
POSTGRES_USER=rhythm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rhythm
# Host port for the compose database (inside Docker it is still 5432)
DB_HOST_PORT=55432
