# Copy to .env for local development. PLACEHOLDERS ONLY — never put real secrets in this file.

# Environment: local | test | staging | production
RHYTHM_ENVIRONMENT=local

# Trading mode: RESEARCH_ONLY (default) | PAPER | LIVE
# LIVE is not implemented and the application refuses to start with it.
RHYTHM_TRADING_MODE=RESEARCH_ONLY
# PAPER trading (simulated orders only) needs BOTH of these:
# RHYTHM_TRADING_MODE=PAPER
# RHYTHM_FEATURES__PAPER_TRADING=true

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
RHYTHM_DATABASE_URL=postgresql+psycopg://rhythm:change-me@localhost:5432/rhythm

# Logging
RHYTHM_LOG_LEVEL=INFO
RHYTHM_LOG_JSON=true

# Readiness: maximum tolerated clock skew vs database clock, seconds
RHYTHM_MAX_CLOCK_SKEW_SECONDS=2

# Data sources (Phase 2): none | mock. "mock" = synthetic MOCK data, local/test only.
RHYTHM_MARKET_DATA_PROVIDER=none
RHYTHM_BROKER_ADAPTER=none
# Corporate-event calendar for the swing event gate (R18): none | mock (local/test only)
RHYTHM_EVENT_PROVIDER=none
# Intraday quote freshness threshold, seconds (illustrative paper-test default)
RHYTHM_FRESHNESS_INTRADAY_MAX_AGE_SECONDS=10

# --- Future phases (leave empty; do not commit real values) ---
# Sharekhan credentials are read from a secrets store reference, never from source control.
# RHYTHM_SHAREKHAN_API_KEY=
# RHYTHM_SHAREKHAN_SECRET_KEY=
# RHYTHM_ANTHROPIC_API_KEY=

# docker-compose only
POSTGRES_USER=rhythm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rhythm
# Host port for the compose database (inside Docker it is still 5432)
DB_HOST_PORT=55432
