# Local DEMO overrides: PAPER mode with MOCK data sources. No secrets in this file.
# Use together with your own .env (which holds POSTGRES_PASSWORD):
#   docker compose --env-file .env --env-file demo.env up -d
#   python3 scripts/demo_paper.py
# MOCK sources are refused outside local/test, so this can never reach staging/production.
RHYTHM_ENVIRONMENT=local
RHYTHM_TRADING_MODE=PAPER
RHYTHM_FEATURES__PAPER_TRADING=true
RHYTHM_MARKET_DATA_PROVIDER=mock
RHYTHM_BROKER_ADAPTER=mock
RHYTHM_EVENT_PROVIDER=mock
RHYTHM_FUNDAMENTALS_PROVIDER=mock
# Phase 7: deterministic MOCK research provider (no API key, no network); gate off.
RHYTHM_FEATURES__RESEARCH_SERVICE=true
RHYTHM_RESEARCH_PROVIDER=mock
# Phase 8: sign-in is OFF for this one-command local demo (refused outside local/test).
# To try sign-in locally, remove this line, set RHYTHM_AUTH__SECRET_KEY in .env and create
# the owner: docker compose exec api rhythm-cli user-create --username owner --role owner
RHYTHM_AUTH__ENABLED=false
